<Window x:Class="Calculator_Nefedov.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Calculator_Nefedov"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="350">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="103*"/>
            <ColumnDefinition Width="72*"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="ResultWindow" HorizontalAlignment="Left" Margin="18,29,0,0" TextWrapping="Wrap" Text="0" VerticalAlignment="Top" Width="314" Height="84" TextAlignment="Right" FontSize="48" Grid.ColumnSpan="2"/>
        <Button x:Name="Button1" Content="1" HorizontalAlignment="Left" Margin="18,128,0,0" VerticalAlignment="Top" Width="80" Height="37" Click="Button1_Click"/>
        <Button x:Name="Button2" Content="2" HorizontalAlignment="Left" Margin="103,128,0,0" VerticalAlignment="Top" Width="80" Height="37" Click="Button2_Click"/>
        <Button x:Name="Button3" Content="3" HorizontalAlignment="Left" Margin="188,128,0,0" VerticalAlignment="Top" Width="80" Height="37" Grid.ColumnSpan="2" Click="Button3_Click"/>
        <Button x:Name="Divide" Content="/" HorizontalAlignment="Left" Margin="67,128,0,0" VerticalAlignment="Top" Width="59" Height="37" Background="#FF3EF2FF" Grid.Column="1" Click="Divide_Click"/>
        <Button x:Name="Button4" Content="4" HorizontalAlignment="Left" Margin="18,170,0,0" VerticalAlignment="Top" Width="80" Height="37" Click="Button4_Click"/>
        <Button x:Name="Button5" Content="5" HorizontalAlignment="Left" Margin="103,170,0,0" VerticalAlignment="Top" Width="80" Height="37" Click="Button5_Click"/>
        <Button x:Name="Button6" Content="6" HorizontalAlignment="Left" Margin="188,170,0,0" VerticalAlignment="Top" Width="80" Height="37" Grid.ColumnSpan="2" Click="Button6_Click"/>
        <Button x:Name="Multiply" Content="*" HorizontalAlignment="Left" Margin="67,170,0,0" VerticalAlignment="Top" Width="59" Height="37" Background="#FF3EF2FF" Grid.Column="1" Click="Multiply_Click"/>
        <Button x:Name="Button7" Content="7" HorizontalAlignment="Left" Margin="18,212,0,0" VerticalAlignment="Top" Width="80" Height="37" Click="Button7_Click"/>
        <Button x:Name="Button8" Content="8" HorizontalAlignment="Left" Margin="103,212,0,0" VerticalAlignment="Top" Width="80" Height="37" Click="Button8_Click"/>
        <Button x:Name="Button9" Content="9" HorizontalAlignment="Left" Margin="188,212,0,0" VerticalAlignment="Top" Width="80" Height="37" Grid.ColumnSpan="2" Click="Button9_Click"/>
        <Button x:Name="Minus" Content="-" HorizontalAlignment="Left" Margin="67,212,0,0" VerticalAlignment="Top" Width="59" Height="37" Background="#FF3EF2FF" Grid.Column="1" Click="Minus_Click"/>
        <Button x:Name="Button0" Content="0" HorizontalAlignment="Left" Margin="18,254,0,0" VerticalAlignment="Top" Width="165" Height="37" Click="Button0_Click"/>
        <Button x:Name="Dot" Content="." HorizontalAlignment="Left" Margin="188,254,0,0" VerticalAlignment="Top" Width="80" Height="37" Grid.ColumnSpan="2" Click="Dot_Click"/>
        <Button x:Name="Plus" Content="+" HorizontalAlignment="Left" Margin="67,254,0,0" VerticalAlignment="Top" Width="59" Height="37" Background="#FF3EF2FF" Grid.Column="1" Click="Plus_Click"/>
        <Button x:Name="Power" Content="^" HorizontalAlignment="Left" Margin="67,296,0,0" VerticalAlignment="Top" Width="59" Height="37" Background="#FF3EF2FF" Grid.Column="1" Click="Power_Click"/>
        <Button x:Name="Clear" Content="C" HorizontalAlignment="Left" Margin="188,296,0,0" VerticalAlignment="Top" Width="80" Height="37" Background="#FFFF5959" Grid.ColumnSpan="2" Click="Clear_Click"/>
        <Button x:Name="Equals" Content="=" HorizontalAlignment="Left" Margin="18,296,0,0" VerticalAlignment="Top" Width="165" Height="37" Background="#FF3BF31C" Click="Equals_Click"/>

    </Grid>
</Window>
